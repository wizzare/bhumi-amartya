{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "recovery-evidence",
    "audit",
    "scratch",
    "scripts",
    "services",
    "scratch_run_verification.ts",
    "playwright*.config.ts",
    "tests",
    "test-wellness-verification.spec.ts",
    "lib/humandesign/hdkit",
    "lib/humandesign/hdkit-main",
    "lib/humandesign/hdRootCause.test.ts"
  ]
}
