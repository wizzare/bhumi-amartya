rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Claims are set by trusted server administration, never by client profiles.
    function isAdminActor() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('founder', false) == true
      );
    }

    function validSupportCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == 'user'
        && request.resource.data.recipientRole == 'admin'
        && request.resource.data.source == 'user'
        && !('parentMessageId' in request.resource.data);
    }

    function validUserReply(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == 'user'
        && request.resource.data.recipientRole == 'admin'
        && request.resource.data.source == 'user'
        && ('parentMessageId' in request.resource.data)
        && exists(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId))
        && get(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId)).data.threadId == request.resource.data.threadId
        && get(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId)).data.ownerUserId == request.auth.uid;
    }

    function validAdminReply(userId) {
      return isAdminActor()
        && request.resource.data.uid == userId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.senderRole == 'admin'
        && request.resource.data.recipientRole == 'user'
        && request.resource.data.source == 'admin';
    }

    function validSystemBirthday(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == 'bhumi'
        && request.resource.data.senderRole == 'system'
        && request.resource.data.recipientRole == 'user'
        && request.resource.data.source == 'system'
        && request.resource.data.type == 'system-birthday';
    }

    function immutableThreadFields() {
      return request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.senderUid == resource.data.senderUid;
    }

    function uidMatches(fieldName) {
      return isSignedIn()
        && (
          (
            request.method == "create"
            && request.resource.data[fieldName] == request.auth.uid
          )
          || (
            request.method == "update"
            && resource.data[fieldName] == request.auth.uid
            && request.resource.data[fieldName] == request.auth.uid
          )
          || (
            (request.method == "get" || request.method == "list" || request.method == "delete")
            && resource.data[fieldName] == request.auth.uid
          )
        );
    }

    function dailyGuidanceDocBelongsToUser(docId) {
      return isSignedIn() && docId.matches(request.auth.uid + "_.*");
    }

    function protectedAccessFields() {
      return [
        "plan",
        "plans",
        "planLabel",
        "tier",
        "tiers",
        "role",
        "roles",
        "guardianRole",
        "adminRole",
        "badge",
        "badges",
        "testerBadge",
        "guardianBadge",
        "recognitionTier",
        "recognitionDate",
        "guardianCandidate",
        "guardianApproved",
        "guardianApprovedAt",
        "guardianApprovedBy",
        "isInternalTester",
        "excludeFromAdminAnalytics",
        "internalTesterLabel",
        "isDeveloper",
        "isFoundingMember",
        "founder",
        "inti",
        "alfa",
        "admin",
        "staff",
        "premium",
        "isPremium",
        "effectiveTier",
        "premiumExpiresAt",
        "paid",
        "paidUntil",
        "paymentStatus",
        "subscription",
        "subscriptions",
        "subscriptionStatus",
        "subscriptionState",
        "entitlement",
        "entitlements",
        "entitlementSource",
        "entitlementUpdatedAt",
        "membership",
        "membershipType",
        "memberType",
        "membershipStartDate",
        "membershipExpiryDate",
        "membershipExpiresAt",
        "billing",
        "billingVerified",
        "purchase",
        "purchases",
        "purchaseState",
        "purchaseTokenHash",
        "productId",
        "basePlanId",
        "packageName",
        "provider",
        "tokenHash",
        "ackStatus",
        "googlePlay",
        "expiryDate",
        "expiresAt",
        "accessStart",
        "accessUntil",
        "accessSource",
        "accessSourceVersion",
        "validUntil",
        "trial",
        "trialStartedAt",
        "trialEndsAt",
        "trialLoginCount",
        "trialStatus",
        "trialCompletedAt",
        "trialEligibilityStatus",
        "antiAbuseDecision",
        "antiAbuseMode",
        "antiAbuseEvaluatedAt",
        "deviceClaimRecorded",
        "lastSuccessfulLoginAt",
        "quota",
        "limits",
        "credits",
        "updatedBy"
      ];
    }

    function doesNotChangeProtectedAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedAccessFields()) == false;
    }

    function doesNotCreateProtectedAccessFields() {
      return request.resource.data.keys().hasAny(protectedAccessFields()) == false;
    }

    // ---- BUILD 126 canonical birth protection (candidate) ----
    // Canonical birth data and server-owned revision metadata are authoritative
    // on users/{uid}/canonical/birth and are written only by the trusted callable
    // (Admin SDK bypasses these rules). Client writes to these fields — on any
    // profile-bearing document path — are denied.
    function canonicalBirthFields() {
      return [
        "birthRevision",
        "placeOfBirth",
        "birthDate",
        "dateOfBirth",
        "birthTime",
        "timeOfBirth",
        "birthCity",
        "birthPlace",
        "cityOfBirth",
        "birthCountry",
        "latitude",
        "longitude",
        "timezone",
        "canonicalBirthRevision",
        "canonicalBirthEpoch",
        "canonicalBirthSchemaVersion",
        "canonicalBirthUpdatedAt",
        "canonicalBirthOperationId"
      ];
    }

    function createsCanonicalBirthFields() {
      return request.resource.data.keys().hasAny(canonicalBirthFields());
    }

    function changesCanonicalBirthFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(canonicalBirthFields());
    }

    // The nested users/{uid}.profile map also carries birth aliases
    // (blueprintInput, timezone, birthCity, latitude, longitude). A legacy
    // client could otherwise reach canonical birth data through this path.
    function nestedProfileBirthChanged(field, fallback) {
      return resource.data.get('profile', {}).get(field, fallback)
        != request.resource.data.get('profile', {}).get(field, fallback);
    }

    function createsNestedProfileBirth() {
      return request.resource.data.get("profile", {}).keys().hasAny(canonicalBirthFields().concat(["blueprintInput"]));
    }

    function changesBlueprintInput() {
      return nestedProfileBirthChanged('blueprintInput', {})
        || nestedProfileBirthChanged('timezone', null)
        || nestedProfileBirthChanged('birthCity', null)
        || nestedProfileBirthChanged('latitude', null)
        || nestedProfileBirthChanged('longitude', null)
        || nestedProfileBirthChanged('birthDate', null)
        || nestedProfileBirthChanged('dateOfBirth', null)
        || nestedProfileBirthChanged('birthTime', null)
        || nestedProfileBirthChanged('timeOfBirth', null)
        || nestedProfileBirthChanged('birthPlace', null)
        || nestedProfileBirthChanged('placeOfBirth', null)
        || nestedProfileBirthChanged('cityOfBirth', null)
        || nestedProfileBirthChanged('birthCountry', null)
        || nestedProfileBirthChanged('birthRevision', null)
        || nestedProfileBirthChanged('canonicalBirthRevision', null)
        || nestedProfileBirthChanged('canonicalBirthEpoch', null)
        || nestedProfileBirthChanged('canonicalBirthSchemaVersion', null)
        || nestedProfileBirthChanged('canonicalBirthUpdatedAt', null)
        || nestedProfileBirthChanged('canonicalBirthOperationId', null);
    }

    match /app_config/{document} {
      allow read: if document == "version";
      allow write: if false;
    }

    // Broadcast metadata is admin-owned; user delivery is fanned out into
    // the existing users/{uid}/communications path and follows its rules.
    match /broadcasts/{broadcastId} {
      allow read, create: if false;
      allow update, delete: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && doesNotCreateProtectedAccessFields()
        && !createsCanonicalBirthFields()
        && !createsNestedProfileBirth();
      allow update: if isOwner(userId)
        && doesNotChangeProtectedAccessFields()
        && !changesCanonicalBirthFields()
        && !changesBlueprintInput();
      allow delete: if false;

      // Server-owned canonical birth record. Readable by the owner, written only
      // by the trusted callable (Admin SDK).
      match /canonical/{document} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Server-owned idempotency receipts. Readable by the owner, written only
      // by the trusted callable (Admin SDK).
      match /birthOperations/{operationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /communications/{messageId} {
        allow read: if isOwner(userId);
        allow create: if validSupportCreate(userId) || validUserReply(userId) || validSystemBirthday(userId);
        allow update: if (isOwner(userId)
          && immutableThreadFields()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isRead', 'isArchived', 'isDismissed', 'updatedAt', 'deliveryAttempts', 'lastDeliveredAt']));
        allow delete: if false;
      }

      match /behaviorMemory/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && documentId == 'wellness'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'updatedAt', 'recommendations', 'lastSeenAt', 'capacityProfile', 'contextCompletions', 'seenRecommendationKeys']);
        allow update: if isOwner(userId)
          && documentId == 'wellness'
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'recommendations', 'lastSeenAt', 'capacityProfile', 'contextCompletions', 'seenRecommendationKeys']);
        allow delete: if false;
      }

      match /weeklyRecommendations/{weekId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.weekId == weekId
          && request.resource.data.keys().hasOnly(['uid', 'weekId', 'startDate', 'endDate', 'kabarMingguIni', 'pikiran', 'ekonomi', 'asmara', 'orangTerdekat', 'maknaBatin', 'yangLagiBerat', 'ruangBaru', 'tema', 'peluang', 'perluDijaga', 'fokus', 'saranBhumi', 'manifestasi', 'generatedAt', 'expiresAt']);
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.weekId == resource.data.weekId
          && resource.data.weekId == weekId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate', 'endDate', 'kabarMingguIni', 'pikiran', 'ekonomi', 'asmara', 'orangTerdekat', 'maknaBatin', 'yangLagiBerat', 'ruangBaru', 'tema', 'peluang', 'perluDijaga', 'fokus', 'saranBhumi', 'manifestasi', 'generatedAt', 'expiresAt']);
        allow delete: if false;
      }

      match /longitudinalWellness/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && documentId == 'current'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'updatedAt', 'events', 'snapshot']);
        allow update: if isOwner(userId)
          && documentId == 'current'
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'events', 'snapshot']);
        allow delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Unknown or server-owned nested user paths are denied by default.
      // Firebase Admin SDK bypasses Firestore Rules for trusted backend writes.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Cross-account collection-group reads stay disabled until a trusted
    // administrative access boundary is approved.
    match /{path=**}/communications/{messageId} {
      allow read: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && doesNotCreateProtectedAccessFields()
        && !createsCanonicalBirthFields()
        && !createsNestedProfileBirth();
      allow update: if isOwner(userId)
        && doesNotChangeProtectedAccessFields()
        && !changesCanonicalBirthFields()
        && !changesBlueprintInput();
      allow delete: if false;
    }

    match /userProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && doesNotCreateProtectedAccessFields()
        && !createsCanonicalBirthFields()
        && !createsNestedProfileBirth();
      allow update: if isOwner(userId)
        && doesNotChangeProtectedAccessFields()
        && !changesCanonicalBirthFields()
        && !changesBlueprintInput();
      allow delete: if false;
    }

    match /dailyStates/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /journeyDailyRecords/{userId} {
      allow read, write: if isOwner(userId);

      match /entries/{dateKey} {
        allow read, write: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /activities/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /blueprints/{userId} {
      allow read: if isOwner(userId);
      // Client writes are restricted to status metadata. Birth inputs, revision
      // provenance, and computed results require a reviewed trusted pathway.
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(["status", "error", "updatedAt"]);
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "error", "updatedAt"]);
      allow delete: if false;
    }

    match /wellnessMappings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /wellnessAssessments/{docId} {
      allow read, write: if uidMatches("uid");
    }

    match /healingProgress/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /journals/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /meditations/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /audioHealing/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /system/astrology/transits/current {
      allow read: if isSignedIn();
    }

    match /journalEntries/{docId} {
      allow read, write: if uidMatches("uid");
    }

    match /meditationEntries/{docId} {
      allow read, write: if uidMatches("uid");
    }

    match /audioHealingEntries/{docId} {
      allow read, write: if uidMatches("uid");
    }

    // Path is keyed by {userId}: ownership must be the document path, not a
    // body `uid` field. `uidMatches("uid")` here let user B write coll/{A}
    // with `{ uid: B }` (DEFECT-2A-2). Owner writes already target coll/{authUid}.
    match /healingMemory/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /journeyData/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /weeklyReports/{reportId} {
      allow read, write: if uidMatches("uid");
    }

    match /weeklyReflections/{docId} {
      allow read, write: if uidMatches("uid");
    }

    match /dailyGuidance/{docId} {
      allow create, update: if (dailyGuidanceDocBelongsToUser(docId)
        && request.resource.data.uid == request.auth.uid);
      allow read, delete: if (dailyGuidanceDocBelongsToUser(docId)
        && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Path is keyed by {userId}: see healingMemory/journeyData note (DEFECT-2A-2).
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /adminAuditLogs/{docId} {
      allow read, write: if false;
    }

    match /analytics/{docId} {
      // Allow unauthenticated writes ONLY for Google Sign-In failure diagnostics.
      // This is necessary to capture telemetry for new users who fail to sign in.
      allow create: if (
          request.resource.data.eventType == "google_signin_failed"
        ) || (
          isSignedIn() && (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid || request.resource.data.uid == null)
        );
      allow read, update, delete: if false;
    }

    // user_activity is actively written by lib/analytics/activityMonitor.ts.
    // Updates must preserve the existing authenticated owner.
    match /user_activity/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if uidMatches("uid");
      allow read, delete: if uidMatches("uid");
    }

    match /telemetry_events/{docId} {
      // Allow unauthenticated writes for sign-up/state diagnostics
      // pre-auth events may have uidHash as null or an 8-char hash string
      allow create: if (
          request.resource.data.eventType in ["AUTH_SIGNUP_STARTED", "AUTH_SIGNUP_FAILED", "AUTH_STATE_ESTABLISHED"]
        ) && (
          request.resource.data.uidHash == null || (request.resource.data.uidHash is string && request.resource.data.uidHash.matches("^[0-9a-f]{8}$"))
        ) && (
          request.resource.data.timestamp is timestamp
        ) && (
          request.resource.data.keys().hasAll(["eventType", "uidHash", "appVersion", "versionCode", "platform", "timestamp"]) &&
          request.resource.data.keys().hasOnly(["eventType", "uidHash", "appVersion", "versionCode", "platform", "timestamp", "correlationId", "metadata"])
        );

      // Allow authenticated writes for all auth lifecycle events
      allow create: if isSignedIn() && (
          request.resource.data.uidHash is string && request.resource.data.uidHash.matches("^[0-9a-f]{8}$")
        ) && (
          request.resource.data.timestamp is timestamp
        ) && (
          request.resource.data.keys().hasAll(["eventType", "uidHash", "appVersion", "versionCode", "platform", "timestamp"]) &&
          request.resource.data.keys().hasOnly(["eventType", "uidHash", "appVersion", "versionCode", "platform", "timestamp", "correlationId", "metadata"])
        );

      // Administrative reads require a separately approved boundary.
      allow read, update, delete: if false;
    }

    // PUBLIC CONFIG (Version Checker, etc)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // TESTER BADGE REGISTRY — replaces the previous hardcoded client-bundled
    // founder/tester array. Keyed by uid. A user may read only their own
    // record; cross-account reads require an approved administrative boundary.
    // No client writes — records are provisioned only via the one-time
    // migration script (Admin SDK, bypasses these rules) or a trusted backend.
    match /testerBadgeRegistry/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ADMIN ROLE REGISTRY — replaces the previous hardcoded client-bundled
    // developer/admin email allowlists. Keyed by uid, no email/name fields.
    // No client writes — records are provisioned only via the one-time
    // migration script (Admin SDK, bypasses these rules) or a trusted backend.
    match /adminRoleRegistry/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /journalMemoryCandidates/{userId} {
      allow read, write: if isOwner(userId);

      match /candidates/{candidateId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- BUILD 122: Server-only Anti-Multi Account & Free Tier Abuse Ledger ----
    // Written and queried strictly via Admin SDK in trusted server bootstrap endpoints.
    // Never client-readable or client-writable, and never wiped by client account deletion.
    match /antiAbuseDeviceClaims/{claimId} {
      allow read, write: if false;
    }

    match /antiAbuseBirthClaims/{hmacId} {
      allow read, write: if false;
    }

    match /antiAbuseAuditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
