rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // NEW AUDITABLE FOUNDER RULE
    function isFounderByEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email == 'wizzare@gmail.com';
    }

    // COMPATIBILITY BRIDGE (Build 83, Option A): production admin/founder
    // accounts were provisioned via Firestore users/{uid}.role /
    // .guardianRole, not Auth custom claims. No migration has provisioned
    // admin/founder custom claims yet (confirmed by read-only audit against
    // bhumiamartya-fe85c on 2026-07-31), so the legacy Firestore-role path
    // MUST stay active until that migration runs, or existing non-Founder
    // admins lose access the moment this ruleset deploys. Remove
    // legacyRoleIsAdminOrFounder() only after a completed + verified custom
    // claims migration for every account currently relying on it.
    function legacyRoleIsAdminOrFounder() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower()
            in ['admin', 'founder', 'dev_admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('guardianRole', '').lower()
            in ['admin', 'founder', 'dev_admin']
        );
    }

    function isFounderOrAdmin() {
      return isSignedIn() && (
        (('email' in request.auth.token) && request.auth.token.email == 'wizzare@gmail.com') ||
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (('founder' in request.auth.token) && request.auth.token.founder == true) ||
        legacyRoleIsAdminOrFounder()
      );
    }

    function isAdminActor() {
      return isFounderByEmail() || isFounderOrAdmin();
    }

    function validSupportCreate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == 'user'
        && request.resource.data.recipientRole == 'admin'
        && request.resource.data.source == 'user'
        && !('parentMessageId' in request.resource.data);
    }

    function validUserReply(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == 'user'
        && request.resource.data.recipientRole == 'admin'
        && request.resource.data.source == 'user'
        && ('parentMessageId' in request.resource.data)
        && exists(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId))
        && get(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId)).data.threadId == request.resource.data.threadId
        && get(/databases/$(database)/documents/users/$(userId)/communications/$(request.resource.data.parentMessageId)).data.ownerUserId == request.auth.uid;
    }

    function validAdminReply(userId) {
      return isAdminActor()
        && request.resource.data.uid == userId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.senderRole == 'admin'
        && request.resource.data.recipientRole == 'user'
        && request.resource.data.source == 'admin';
    }

    function validSystemBirthday(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.senderUid == 'bhumi'
        && request.resource.data.senderRole == 'system'
        && request.resource.data.recipientRole == 'user'
        && request.resource.data.source == 'system'
        && request.resource.data.type == 'system-birthday';
    }

    function immutableThreadFields() {
      return request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.senderUid == resource.data.senderUid;
    }

    function uidMatches(fieldName) {
      return isSignedIn()
        && (
          (
            (request.method == "create" || request.method == "update")
            && request.resource.data[fieldName] == request.auth.uid
          )
          || (
            (request.method == "get" || request.method == "list" || request.method == "delete")
            && resource.data[fieldName] == request.auth.uid
          )
        );
    }

    function dailyGuidanceDocBelongsToUser(docId) {
      return isSignedIn() && docId.matches(request.auth.uid + "_.*");
    }

    function protectedAccessFields() {
      return [
        "plan",
        "plans",
        "planLabel",
        "tier",
        "tiers",
        "role",
        "roles",
        "guardianRole",
        "adminRole",
        "badge",
        "badges",
        "testerBadge",
        "guardianBadge",
        "recognitionTier",
        "recognitionDate",
        "guardianCandidate",
        "guardianApproved",
        "guardianApprovedAt",
        "guardianApprovedBy",
        "isInternalTester",
        "excludeFromAdminAnalytics",
        "internalTesterLabel",
        "isDeveloper",
        "isFoundingMember",
        "founder",
        "inti",
        "alfa",
        "admin",
        "staff",
        "premium",
        "isPremium",
        "effectiveTier",
        "premiumExpiresAt",
        "paid",
        "paidUntil",
        "paymentStatus",
        "subscription",
        "subscriptions",
        "subscriptionStatus",
        "subscriptionState",
        "entitlement",
        "entitlements",
        "entitlementSource",
        "entitlementUpdatedAt",
        "membership",
        "membershipType",
        "memberType",
        "membershipStartDate",
        "membershipExpiryDate",
        "membershipExpiresAt",
        "billing",
        "billingVerified",
        "purchase",
        "purchases",
        "purchaseState",
        "purchaseTokenHash",
        "productId",
        "basePlanId",
        "packageName",
        "provider",
        "tokenHash",
        "ackStatus",
        "googlePlay",
        "expiryDate",
        "expiresAt",
        "accessStart",
        "accessUntil",
        "accessSource",
        "accessSourceVersion",
        "validUntil",
        "trial",
        "trialStartedAt",
        "trialEndsAt",
        "trialLoginCount",
        "trialStatus",
        "trialCompletedAt",
        "lastSuccessfulLoginAt",
        "quota",
        "limits",
        "credits",
        "updatedBy"
      ];
    }

    function doesNotChangeProtectedAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedAccessFields()) == false;
    }

    function doesNotCreateProtectedAccessFields() {
      return request.resource.data.keys().hasAny(protectedAccessFields()) == false;
    }

    match /app_config/{document} {
      allow read: if document == "version";
      allow write: if isFounderByEmail() || isFounderOrAdmin();
    }

    // Broadcast metadata is admin-owned; user delivery is fanned out into
    // the existing users/{uid}/communications path and follows its rules.
    match /broadcasts/{broadcastId} {
      allow read: if isAdminActor();
      allow create: if isAdminActor()
        && request.resource.data.id == broadcastId
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.targetGroups is list;
      allow update, delete: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && doesNotCreateProtectedAccessFields();
      allow update: if isOwner(userId) && doesNotChangeProtectedAccessFields();
      allow delete: if isOwner(userId);

      // Founder can list and get ALL users
      allow list: if isFounderByEmail() || isFounderOrAdmin();
      allow get: if isFounderByEmail() || isFounderOrAdmin();
      allow create, update, delete: if isFounderByEmail() || isFounderOrAdmin();

      match /communications/{messageId} {
        allow read: if isOwner(userId) || isAdminActor();
        allow create: if validSupportCreate(userId) || validUserReply(userId) || validAdminReply(userId) || validSystemBirthday(userId);
        allow update: if (isOwner(userId)
          && immutableThreadFields()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isRead', 'isArchived', 'isDismissed', 'updatedAt', 'deliveryAttempts', 'lastDeliveredAt']))
          || (isAdminActor() && immutableThreadFields());
        allow delete: if false;
      }

      match /behaviorMemory/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && documentId == 'wellness'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'updatedAt', 'recommendations', 'lastSeenAt', 'capacityProfile', 'contextCompletions', 'seenRecommendationKeys']);
        allow update: if isOwner(userId)
          && documentId == 'wellness'
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'recommendations', 'lastSeenAt', 'capacityProfile', 'contextCompletions', 'seenRecommendationKeys']);
        allow delete: if false;
      }

      match /weeklyRecommendations/{weekId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.weekId == weekId
          && request.resource.data.keys().hasOnly(['uid', 'weekId', 'startDate', 'endDate', 'kabarMingguIni', 'pikiran', 'ekonomi', 'asmara', 'orangTerdekat', 'maknaBatin', 'yangLagiBerat', 'ruangBaru', 'tema', 'peluang', 'perluDijaga', 'fokus', 'saranBhumi', 'manifestasi', 'generatedAt', 'expiresAt']);
        allow update: if isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.weekId == resource.data.weekId
          && resource.data.weekId == weekId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate', 'endDate', 'kabarMingguIni', 'pikiran', 'ekonomi', 'asmara', 'orangTerdekat', 'maknaBatin', 'yangLagiBerat', 'ruangBaru', 'tema', 'peluang', 'perluDijaga', 'fokus', 'saranBhumi', 'manifestasi', 'generatedAt', 'expiresAt']);
        allow delete: if false;
      }

      match /longitudinalWellness/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && documentId == 'current'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'updatedAt', 'events', 'snapshot']);
        allow update: if isOwner(userId)
          && documentId == 'current'
          && request.resource.data.uid == resource.data.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'events', 'snapshot']);
        allow delete: if false;
      }

      // Unknown or server-owned nested user paths are denied by default.
      // Firebase Admin SDK bypasses Firestore Rules for trusted backend writes.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Collection-group reads require an explicit recursive match in Rules v2.
    // Keep this path admin-only; user reads remain restricted to their own
    // users/{uid}/communications subcollection above.
    match /{path=**}/communications/{messageId} {
      allow read: if isAdminActor();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && doesNotCreateProtectedAccessFields();
      allow update: if isOwner(userId) && doesNotChangeProtectedAccessFields();
      allow delete: if isOwner(userId);
      allow read, write: if isFounderByEmail() || isFounderOrAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && doesNotCreateProtectedAccessFields();
      allow update: if isOwner(userId) && doesNotChangeProtectedAccessFields();
      allow delete: if isOwner(userId);
      allow read, write: if isFounderByEmail() || isFounderOrAdmin();
    }

    match /dailyStates/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /journeyDailyRecords/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /entries/{dateKey} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /activities/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /blueprints/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
    }

    match /wellnessMappings/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
    }

    match /wellnessAssessments/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /healingProgress/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /journals/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /meditations/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /audioHealing/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /system/astrology/transits/current {
      allow read: if isSignedIn();
    }

    match /journalEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /meditationEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /audioHealingEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /healingMemory/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /journeyData/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /weeklyReports/{reportId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /weeklyReflections/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /dailyGuidance/{docId} {
      allow create, update: if (dailyGuidanceDocBelongsToUser(docId)
        && request.resource.data.uid == request.auth.uid) || isFounderByEmail() || isFounderOrAdmin();
      allow read, delete: if (dailyGuidanceDocBelongsToUser(docId)
        && (resource == null || resource.data.uid == request.auth.uid)) || isFounderByEmail() || isFounderOrAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isFounderByEmail() || isFounderOrAdmin();
    }

    match /notifications/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /adminAuditLogs/{docId} {
      allow read, write: if isFounderByEmail() || isFounderOrAdmin();
    }

    match /analytics/{docId} {
      allow create: if isSignedIn()
        && (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid || request.resource.data.uid == null);
      allow read, update, delete: if isFounderByEmail() || isFounderOrAdmin();
    }

    match /user_activity/{docId} {
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    // PUBLIC CONFIG (Version Checker, etc)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }

    // TESTER BADGE REGISTRY — replaces the previous hardcoded client-bundled
    // founder/tester array. Keyed by uid. A user may read only their own
    // record; admins may read any record (for the admin activity dashboard).
    // No client writes — records are provisioned only via the one-time
    // migration script (Admin SDK, bypasses these rules) or a trusted backend.
    match /testerBadgeRegistry/{uid} {
      allow read: if isOwner(uid) || isAdminActor();
      allow write: if false;
    }

    // ADMIN ROLE REGISTRY — replaces the previous hardcoded client-bundled
    // developer/admin email allowlists. Keyed by uid, no email/name fields.
    // No client writes — records are provisioned only via the one-time
    // migration script (Admin SDK, bypasses these rules) or a trusted backend.
    match /adminRoleRegistry/{uid} {
      allow read: if isOwner(uid) || isAdminActor();
      allow write: if false;
    }
  }
}
