rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // NEW AUDITABLE FOUNDER RULE
    function isFounderByEmail() {
      return isSignedIn() && request.auth.token.email == 'wizzare@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFounderOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'wizzare@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            getUserData().guardianRole == 'founder' ||
            getUserData().guardianRole == 'admin' ||
            getUserData().role == 'admin'
          )
        )
      );
    }

    function uidMatches(fieldName) {
      return isSignedIn()
        && (
          (
            (request.method == "create" || request.method == "update")
            && request.resource.data[fieldName] == request.auth.uid
          )
          || (
            (request.method == "get" || request.method == "list" || request.method == "delete")
            && resource.data[fieldName] == request.auth.uid
          )
        );
    }

    function dailyGuidanceDocBelongsToUser(docId) {
      return isSignedIn() && docId.matches(request.auth.uid + "_.*");
    }

    // USERS COLLECTION
    match /users/{userId} {
      // User can always read/write their own doc
      allow read, write: if isOwner(userId);

      // Founder can list and get ALL users
      allow list: if isFounderByEmail() || isFounderOrAdmin();
      allow get: if isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /dailyStates/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /journeyDailyRecords/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /blueprints/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
    }

    match /wellnessMappings/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
    }
    
    match /healingProgress/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /journals/{userId} {
      allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /system/astrology/transits/current {
      allow read: if isSignedIn();
    }

    match /journalEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /meditationEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /audioHealingEntries/{docId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /healingMemory/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /journeyData/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /weeklyReports/{reportId} {
      allow read, write: if uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();
    }

    match /dailyGuidance/{docId} {
      allow create, update: if (dailyGuidanceDocBelongsToUser(docId)
        && request.resource.data.uid == request.auth.uid) || isFounderByEmail() || isFounderOrAdmin();
      allow read, delete: if (dailyGuidanceDocBelongsToUser(docId)
        && (resource == null || resource.data.uid == request.auth.uid)) || isFounderByEmail() || isFounderOrAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isFounderByEmail() || isFounderOrAdmin();
    }

    match /notifications/{userId} {
      allow read, write: if isOwner(userId) || uidMatches("uid") || isFounderByEmail() || isFounderOrAdmin();

      match /{document=**} {
        allow read, write: if isOwner(userId) || isFounderByEmail() || isFounderOrAdmin();
      }
    }

    match /adminAuditLogs/{docId} {
      allow read, write: if isFounderByEmail() || isFounderOrAdmin();
    }

    // PUBLIC CONFIG (Version Checker, etc)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }
  }
}
