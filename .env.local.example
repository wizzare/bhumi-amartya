NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
HUMAN_DESIGN_SERVICE_URL=http://localhost:8000

# CDI-108-01 — canonical Swiss Ephemeris natal service (genuine Placidus + Chiron).
# Server-only override consumed by app/api/humandesign/astrology/route.ts.
# Point at a deployed services/humandesign-api instance, e.g.
#   https://bhumi-humandesign-api-xxxxx-as.a.run.app/calculate-astrology
# Leave empty to use the built-in canonical target. When the service is
# unreachable the app fails closed: it keeps the local chart (accurate table
# Chiron + genuine Whole Sign houses) and never synthesises Placidus.
ASTROLOGY_SERVICE_URL=http://localhost:8000/calculate-astrology

# Server-only. Required for /api/access/july1-grant and admin seed scripts.
# Never expose this as NEXT_PUBLIC_* and never commit a real credential.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
# Vercel production may use this equivalent server-only name:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# --- Human Design API (client-safe) ---
# Required for Android APK production build.
# Set to Cloud Run HTTPS URL, e.g.:
#   https://bhumi-humandesign-api-xxxxx-as.a.run.app/calculate
# Leave empty for web dev (auto-fallback to /api/humandesign/calculate)
NEXT_PUBLIC_HUMAN_DESIGN_API_URL=

# --- Astrology / natal ephemeris API (client-safe) — CDI-108-01 ---
# Absolute override for getAstrologyApiUrl(). Leave empty so the ENL APK uses
# {NEXT_PUBLIC_WEB_APP_URL}/api/humandesign/astrology and web uses the relative
# path. Chiron is always accurate (local Swiss Ephemeris table); this only
# controls where genuine Placidus houses are fetched from.
NEXT_PUBLIC_ASTROLOGY_API_URL=
