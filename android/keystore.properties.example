# Release signing credentials template
# Copy this file to android/keystore.properties and fill in your values.
# DO NOT commit the actual keystore.properties file.
#
# Environment variables are checked first (BHUMI_RELEASE_STORE_FILE,
# BHUMI_RELEASE_KEY_ALIAS, BHUMI_RELEASE_STORE_PASSWORD,
# BHUMI_RELEASE_KEY_PASSWORD). If set, they take precedence.
#
# If neither env vars nor this file provide all four values,
# release builds will fail with a missing signing configuration error.

BHUMI_RELEASE_STORE_FILE=/path/to/your/upload-key.jks
BHUMI_RELEASE_KEY_ALIAS=<your-key-alias>
BHUMI_RELEASE_STORE_PASSWORD=<store-password>
BHUMI_RELEASE_KEY_PASSWORD=<key-password>
